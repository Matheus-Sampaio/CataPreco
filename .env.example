# Postgres
DB_PASSWORD=troque-essa-senha

# Tailscale (acesso remoto pelo seu tailnet — opcional)
# Gere uma auth key em https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=tskey-auth-XXXX
# TS_HOSTNAME=catapreco

# Proxies (opcional)
# PROXY_URL=http://user:pass@host:3128
# PROXY_INTERNATIONAL_URL=http://user:pass@vps-chile:3128

# Ollama default (seu CT 110) — configurável também pela UI por usuário
# DEFAULT_AI_BASE_URL=http://192.168.0.110:11435/v1

# Firecrawl (último recurso anti-bot) — opcional. Cloud ou self-host:
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_API_URL=https://api.firecrawl.dev   # ou http://seu-host:3002 p/ self-host

# SearXNG (meta-busca self-hosted p/ lojas nicho) — sobe LIGADO por padrão
# no compose e o worker já usa. Para DESLIGAR (economiza ~150MB de RAM),
# descomente as duas linhas:
# SEARXNG_URL=
# SEARXNG_REPLICAS=0   # nem sobe o container
# Rodando SearXNG próprio em outro host? Só aponte:
# SEARXNG_URL=http://meu-searxng:8080
