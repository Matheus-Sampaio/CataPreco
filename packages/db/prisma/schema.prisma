// CataPreço database schema
// All money is integer cents (Int). Currencies are ISO codes ("BRL", "USD").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// scrypt hash in the format "salt:hash" (hex)
  passwordHash String
  isAdmin      Boolean  @default(false)
  theme        String   @default("system") // system | light | dark
  createdAt    DateTime @default(now())

  sessions    Session[]
  products    Product[]
  purchases   Purchase[]
  channels    NotificationChannel[]
  aiConfig    AiConfig?
  proxyConfig ProxyConfig?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Global app settings (registration toggle etc.)
model AppSetting {
  key   String @id
  value String
}

model Product {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  domain       String
  title        String?
  image        String?
  currency     String   @default("BRL")
  targetCents  Int?
  /// interval between checks, minutes
  intervalMin  Int      @default(360)
  /// drop-alert thresholds (notify when price falls by X cents or Y%)
  dropAbsCents Int?
  dropPct      Int?
  nextCheckAt  DateTime @default(now())
  /// extracting | searching | active | pending_review | archived_bought | archived_dismissed | error
  status          String  @default("extracting")
  remessaConforme Boolean @default(false)
  /// lowest current listing price across marketplaces (denormalized for dashboard)
  minPriceCents  Int?
  lowestEverCents Int?
  /// PriceCandidate[] waiting user confirmation (Price Selection Modal)
  pendingCandidates Json?
  /// last extraction debug log lines
  lastLogs      Json?
  /// brand-flexible: alternativa marcas com mesma spec são bem-vindas
  flexBrands    Boolean @default(false)
  /// e.g. ["1tb","m2","nvme","gen4","3500 mb/s"] — IA-extracted, user-editable
  specTokens    Json?
  /// e.g. "ssd", "console", "gpu"
  category      String?
  /// last time the flex-brand search ran
  lastFlexSearchAt DateTime?
  /// last cross-marketplace search ran (even while pending_review)
  searchedAt      DateTime?
  /// last AI classification attempt (commodity/spec) ran
  classifiedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings  Listing[]
  purchases Purchase[]

  @@index([userId, status])
  @@index([nextCheckAt, status])
}

model Listing {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace  String
  url          String
  title        String?
  /// true for the URL the user pasted; false for auto-found matches
  isPrimary    Boolean  @default(false)
  /// true when found via spec-based (brand-flexible) search
  isAlternative Boolean @default(false)
  /// brand detected from title (e.g. "sandisk") for alternatives
  brand        String?
  /// price in the listing's native currency; BRL-normalized copy lives in priceBrlCents
  priceCents   Int?
  /// BRL-normalized price (when currency != BRL). Aggregates/history use this.
  priceBrlCents Int?
  listPriceCents Int?
  currency     String   @default("BRL")
  stock        String   @default("unknown")
  matchScore   Float?
  lastCheckedAt DateTime?
  createdAt    DateTime @default(now())

  points PricePoint[]
  checks PriceCheck[]

  @@index([productId])
  @@unique([productId, url])
}

model PricePoint {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ts         DateTime @default(now())
  priceCents Int
  stock      String   @default("unknown")

  @@index([listingId, ts])
}

/// Audit log of every scraping attempt — the debug trail.
model PriceCheck {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ts         DateTime @default(now())
  ok         Boolean
  method     String?  // jsonld | adapter | generic | ai | user
  error      String?
  durationMs Int?
  candidates Json?    // PriceCandidate[]
  logs       Json?    // string[]

  @@index([listingId, ts])
}

model Purchase {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  paidCents      Int
  referenceCents Int
  savedCents     Int
  purchasedAt    DateTime @default(now())

  @@index([userId])
}

model NotificationChannel {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// telegram | discord | pushover | ntfy | gotify
  type    String
  enabled Boolean @default(true)
  /// channel config (botToken, chatId, webhookUrl, token, user, server, topic, appToken)
  config  Json
  /// event kinds this channel receives: ["price_drop","target_hit","back_in_stock"]
  events  Json    @default("[\"price_drop\",\"target_hit\",\"back_in_stock\"]")

  @@unique([userId, type])
}

model AiConfig {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ollama | openai | anthropic
  provider String  @default("ollama")
  baseUrl  String  @default("http://192.168.0.110:11435/v1")
  apiKey   String?
  model    String  @default("qwen3:8b")
  enabled  Boolean @default(true)
}

model ProxyConfig {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   String? // http://user:pass@host:port
  /// "international" | "all" | "none"
  useFor   String  @default("none")
}
